<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:WILLOWMAKER.Core.Models"
             xmlns:vm="clr-namespace:WILLOWMAKER.Core.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" Width="1150" d:DesignHeight="600" Height="600"
             x:Class="WILLOWMAKER.Core.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel /> <!-- This Only Sets The DataContext For The Previewer In An IDE, To Set The Actual DataContext For Runtime, Set The DataContext Property In Code -->
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Shared By The Master Server And CDN Dropdowns, So That Both Present Their Addresses The Same Way; The Address Stays Centred Whether Or Not The Tooltip Badge Is Shown -->
        <DataTemplate x:Key="AddressSelectItemTemplate" x:DataType="models:AddressSelectItem">
            <Grid>
                <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Width="16" Height="16" CornerRadius="8" Background="#555555" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding HasTooltip}" ToolTip.Tip="{Binding TooltipText}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Colours & Palettes: https://materialui.co/ -->

    <StackPanel>
        <Grid ColumnDefinitions="Auto, Auto" Height="600">
            <StackPanel Grid.Column="0" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#131418">
                <Button Height="150" Command="{Binding GoToURLCommand}" CommandParameter="{Binding GitHubLink}" Cursor="Hand" Background="#131418" >
                    <Image Source="/Assets/github-logo.png" Margin="15" />
                    <Button.Styles>
                        <Style Selector="Button:pointerover > Image">
                            <Setter Property="Width" Value="130" />
                            <Setter Property="Height" Value="130" />
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#131418" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Height="150" Command="{Binding GoToURLCommand}" CommandParameter="{Binding WebPortalLink}" Cursor="Hand" Background="#131418" >
                    <Image Source="/Assets/world-wide-web.png" Margin="15" />
                    <Button.Styles>
                        <Style Selector="Button:pointerover > Image">
                            <Setter Property="Width" Value="130" />
                            <Setter Property="Height" Value="130" />
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#131418" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Height="150" Command="{Binding GoToURLCommand}" CommandParameter="{Binding RedditLink}" Cursor="Hand" Background="#131418" >
                    <Image Source="/Assets/reddit-logo.png" Margin="15" />
                    <Button.Styles>
                        <Style Selector="Button:pointerover > Image">
                            <Setter Property="Width" Value="130" />
                            <Setter Property="Height" Value="130" />
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#131418" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Height="150" Command="{Binding GoToURLCommand}" CommandParameter="{Binding DiscordLink}" Cursor="Hand" Background="#131418" >
                    <Image Source="/Assets/discord-logo.png" Margin="15" />
                    <Button.Styles>
                        <Style Selector="Button:pointerover > Image">
                            <Setter Property="Width" Value="130" />
                            <Setter Property="Height" Value="130" />
                            <Setter Property="Margin" Value="10"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#131418" />
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Width="1000" Background="#131418" Focusable="True" PointerPressed="Background_PointerPressed">
                <StackPanel.Background>
                    <ImageBrush Source="/Assets/caldavar.png" Stretch="UniformToFill" Opacity="0.20" />
                </StackPanel.Background>

                <Grid RowDefinitions="Auto, Auto">
                    <Grid Grid.Row="0" Height="540" ColumnDefinitions="Auto, Auto, Auto">
                        <StackPanel Grid.Column="0" Width="300" />

                        <StackPanel Grid.Column="1" Width="400" Margin="0, 160, 0, 0">
                            <StackPanel.Styles>
                                <!-- Stretch The Dropdown Items Across The Dropdown, So That The Shared Item Template Can Centre Each Address -->
                                <Style Selector="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </StackPanel.Styles>

                            <Label Width="400" Margin="0, 0, 0, 5" HorizontalAlignment="Center" HorizontalContentAlignment="Center">Master Server Address</Label>

                            <ComboBox Name="MasterServerAddressDropdown" ItemsSource="{Binding AvailableMasterServerOptions}" SelectedItem="{Binding SelectedMasterServerAddressItem}" ItemTemplate="{StaticResource AddressSelectItemTemplate}" IsEnabled="{Binding MasterServerInputIsEnabled}" Width="400" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" />

                            <TextBox Text="{Binding CustomMasterServerAddress}" Width="400" Margin="0, 10, 0, 0" HorizontalAlignment="Center" TextAlignment="Center" IsVisible="{Binding CanShowCustomMasterServerAddressField}" IsEnabled="{Binding MasterServerInputIsEnabled}" LostFocus="CustomMasterServerAddress_LostFocus" KeyDown="CustomMasterServerAddress_KeyDown" />

                            <TextBlock Text="{Binding MasterServerStatusMessage}" IsVisible="{Binding MasterServerStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="OrangeRed" Width="400" Margin="0, 5, 0, 0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" />

                            <Label Width="400" Margin="0, 10, 0, 5" HorizontalAlignment="Center" HorizontalContentAlignment="Center">Content Delivery Network</Label>

                            <ComboBox Name="CDNOptionsDropdown" ItemsSource="{Binding AvailableCDNOptions}" SelectedItem="{Binding SelectedCDNAddressItem}" ItemTemplate="{StaticResource AddressSelectItemTemplate}" IsEnabled="{Binding CDNInputIsEnabled}" Width="400" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" />

                            <TextBox Text="{Binding CustomCDNAddress}" Width="400" Margin="0, 10, 0, 0" HorizontalAlignment="Center" TextAlignment="Center" IsVisible="{Binding CanShowCustomCDNAddressField}" IsEnabled="{Binding CDNInputIsEnabled}" LostFocus="CustomCDNAddress_LostFocus" KeyDown="CustomCDNAddress_KeyDown" />

                            <TextBlock Classes.probing="{Binding CDNProbeInProgress}"
                                       Classes.online="{Binding CDNProbeSucceeded}"
                                       Classes.failed="{Binding CDNProbeFailed}"
                                       Text="{Binding CDNProbeStatusMessage}"
                                       Width="400" Margin="0, 5, 0, 0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="11">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock.probing">
                                        <Setter Property="Foreground" Value="#AAAAAA" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </Style>
                                    <Style Selector="TextBlock.online">
                                        <Setter Property="Foreground" Value="DarkSeaGreen" />
                                        <Setter Property="FontStyle" Value="Normal" />
                                    </Style>
                                    <Style Selector="TextBlock.failed">
                                        <Setter Property="Foreground" Value="OrangeRed" />
                                        <Setter Property="FontStyle" Value="Normal" />
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0" HorizontalAlignment="Center">
                                <Button Command="{Binding LaunchMapEditorCommand}" Width="175" Height="60" Margin="0, 0, 5, 0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanLaunchMapEditor}" Background="DarkGreen">
                                    <Button.Styles>
                                        <Style Selector="Button TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1)" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </Style>
                                        <Style Selector="Button:pointerover TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1.10)" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Green" />
                                        </Style>
                                        <!-- Keep The Pressed Look Consistent With The Hover Look, Otherwise The Default Theme Flashes Its Grey Pressed Brush And Drops The Enlarged Text -->
                                        <Style Selector="Button:pressed TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1.10)" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Green" />
                                        </Style>
                                    </Button.Styles>

                                    <TextBlock Text="{Binding LaunchMapEditorButtonText}" RenderTransformOrigin="50%, 50%">
                                        <TextBlock.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                            </Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </Button>

                                <Button x:Name="LaunchGameClientButton" Width="215" Height="60" Margin="5, 0, 0, 0" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{Binding CanLaunchGameClient}" Background="DarkGreen">
                                    <Button.Styles>
                                        <Style Selector="Button TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1)" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </Style>
                                        <Style Selector="Button:pointerover TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1.10)" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Green" />
                                        </Style>
                                        <!-- Keep The Enlarged Text On Press So A Click Does Not Shrink The Label Back To Its Resting Size -->
                                        <Style Selector="Button:pressed TextBlock">
                                            <Setter Property="RenderTransform" Value="scale(1.10)" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                        <!-- While The Press Is Still Pending (The Initial Window, And Therefore The Whole Of A Quick Click) Keep The Resting Appearance; Once The Code-Behind Drops The "HoldPending" Class The Theme's Default Pressed Appearance Returns As The Hold's "Loading" Cue -->
                                        <Style Selector="Button.HoldPending:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Green" />
                                        </Style>
                                    </Button.Styles>

                                    <!-- The Fill Rectangle Grows From The Left As The Play Button Is Held, Signalling The Hidden "Launch Without Synchronisation" Gesture; Its Width Is Driven From The Code-Behind -->
                                    <Grid x:Name="LaunchGameClientHoldFillHost">
                                        <Rectangle x:Name="LaunchGameClientHoldFill" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="0" Fill="#40FFFFFF" />

                                        <TextBlock Text="{Binding LaunchGameClientButtonText}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%, 50%">
                                            <TextBlock.Transitions>
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                                </Transitions>
                                            </TextBlock.Transitions>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="2" Width="300" VerticalAlignment="Top" Margin="0, 15, 0, 0" ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding UpdateCheckIsInProgress}">
                                <Path Classes="spinner" Width="15" Height="15" VerticalAlignment="Center" Margin="0, 0, 5, 0"
                                      Stroke="DarkSeaGreen" StrokeThickness="1.5" StrokeLineCap="Round"
                                      Data="M 7.5,1.5 A 6,6 0 1 1 1.5,7.5"
                                      RenderTransformOrigin="50%, 50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Styles>
                                        <Style Selector="Path.spinner">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0.0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360.0" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Path.Styles>
                                </Path>
                                <Label Foreground="DarkSeaGreen" VerticalAlignment="Center" Padding="0, 0, 5, 0"
                                       Content="Checking For Update ..." />
                            </StackPanel>
                            <Label Grid.Column="0" Foreground="OrangeRed" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5, 0"
                                   Content="Releases Repository Not Reachable"
                                   IsVisible="{Binding ReleasesRepositoryIsUnreachable}" />
                            <Label Grid.Column="0" Foreground="DarkSeaGreen" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5, 0"
                                   Content="No Update Available"
                                   IsVisible="{Binding UpdateIsUnavailable}" />
                            <Label Grid.Column="0" Foreground="DarkSeaGreen" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5, 0"
                                   Content="{Binding UpdateIsPendingMessage}"
                                   IsVisible="{Binding UpdateIsPending}" />
                            <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsVisible="{Binding UpdateIsDownloading}"
                                  ColumnDefinitions="Auto, 40">
                                <Label Grid.Column="0" Foreground="DarkSeaGreen" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5, 0, 5, 0"
                                       Content="{Binding UpdateDownloadMessage}" />
                                <Label Grid.Column="1" Foreground="DarkSeaGreen" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0, 0, 5, 0"
                                       Content="{Binding UpdateDownloadPercentDisplay}" />
                            </Grid>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding UpdateIsRestarting}">
                                <Path Classes="spinner" Width="15" Height="15" VerticalAlignment="Center" Margin="0, 0, 5, 0"
                                      Stroke="DarkSeaGreen" StrokeThickness="1.5" StrokeLineCap="Round"
                                      Data="M 7.5,1.5 A 6,6 0 1 1 1.5,7.5"
                                      RenderTransformOrigin="50%, 50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Styles>
                                        <Style Selector="Path.spinner">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0.0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360.0" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Path.Styles>
                                </Path>
                                <Label Foreground="DarkSeaGreen" VerticalAlignment="Center" Padding="0, 0, 5, 0"
                                       Content="Restarting ..." />
                            </StackPanel>
                            <Label Grid.Column="1" Content="{Binding VersionDisplay}" Padding="5, 0, 0, 0" Margin="0, 0, 15, 0" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Height="60">
                        <!-- Synchronisation Success State: Four Columns With Synchronisation File Data -->
                        <Grid Height="20" Margin="10, 0, 10, 0" ColumnDefinitions="*, *, *, *" IsVisible="{Binding !SynchronisationIsFailed}">
                            <TextBlock Grid.Column="0" Text="{Binding DownloadedFilesDisplay}" HorizontalAlignment="Left"   VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" />
                            <TextBlock Grid.Column="1" Text="{Binding RemovedFilesDisplay}"    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" />
                            <TextBlock Grid.Column="2" Text="{Binding SkippedFilesDisplay}"    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" />
                            <TextBlock Grid.Column="3" Text="{Binding UpToDateFilesDisplay}"   HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" />
                        </Grid>

                        <!-- Synchronisation Failure State: A Single Centred Failure Message -->
                        <TextBlock Height="20" Margin="10, 0, 10, 0" Text="{Binding SynchronisationStatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" IsVisible="{Binding SynchronisationIsFailed}" />

                        <ProgressBar Width="980" Height="15" Margin="0, 10, 0, 15" Minimum="0" Maximum="100" Value="{Binding SynchronisationProgressPercent}" IsVisible="{Binding SynchronisationIsScheduled}" Foreground="DarkGreen" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>

</UserControl>
